name: Update daily car data

on:
  schedule:
    - cron: '30 2 * * *'   # every day at 02:30 UTC, which is 8:00 AM in India
  workflow_dispatch:        # lets you run it by hand from the Actions tab

permissions:
  contents: write

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Collect headlines
        run: node scripts/update-news.mjs
      - name: Collect official car specs and safety ratings
        run: node scripts/update-cars.mjs
      - name: Save changes
        run: |
          git config user.name "hashpatrol-bot"
          git config user.email "actions@users.noreply.github.com"
          git add data/news.json data/cars.json
          git diff --staged --quiet || (git commit -m "Update daily data" && git push)
